# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin
/traepoc
/traepoc.exe

# Config with secrets (use config.example.json)
# 新版布局：配置收进 config/、运行状态收进 data/（见 cmd/server/layout.go）。
# 直接忽略整个 config/ 目录；示例文件仍在仓库根，供手工复制。
config/
config.json
# 旧版平铺路径保留忽略规则：迁移期间的旧文件同样不应提交
responses.json
model.json
# 第三方上游配置含 API Key（用 third_party.example.json）
third_party.json
# Trae 上游配置含 access_token / refresh_token / 设备私钥
trae.json
# Anthropic 接入配置（用 anthropic.example.json；映射本身不含密钥，防手滑写密钥）
anthropic.json

# Build artifacts
*.tmp
__pycache__/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
# docs/ 进版本库：配置布局、弃用清单等运维文档需要跟代码一起演进
# （早期这里排除整个目录，是为了避免把上游同步过程的工作文档带进来）

# 设计/计划文档（但 README.md 与 docs/ 必须进版本库）
*.md
!README.md
!docs/**/*.md

# Windows binaries
/wb2api.exe
/login.exe
/credit.exe

# 本地验证工具（判据逆向过程脚本，结论沉淀于 data/desktop-task-protocol.md）
/cmd/desktopverify*/
*.zip
server.exe
.DS_Store
.playwright-mcp/

# 本地 Claude Code 配置与技能包（含 fnos CLI 等，非项目代码）
.claude/

